# 复制为 .env 并填写真实值；.env 已被 .gitignore 忽略，不会提交

# OpenRouter（embedding / LLM / rerank 共用）
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# 存储
MYSQL_URL=mysql+pymysql://root:root@127.0.0.1:3306/smarthub?charset=utf8mb4
MILVUS_URI=http://127.0.0.1:19530
ES_URL=http://127.0.0.1:9200
REDIS_URL=redis://127.0.0.1:6379/0

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
JWT_SECRET=change-me
